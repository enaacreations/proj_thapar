{
  "name": "proj-thapar",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@proj/api",
    "dev:mobile": "turbo run dev --filter=@proj/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "npm run db:generate --workspace @proj/api",
    "db:migrate": "npm run db:migrate --workspace @proj/api",
    "db:seed": "npm run db:seed --workspace @proj/api",
    "db:studio": "npm run db:studio --workspace @proj/api",
    "dev:admin": "turbo run dev --filter=@proj/admin"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "~6.0.3"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20"
  }
}
