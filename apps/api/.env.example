PORT=4000
NODE_ENV=development
# Comma-separated origins, or * to allow any.
CORS_ORIGIN=*

# Local Postgres over the Unix socket, using peer auth (no password needed).
# Replace "adish" with your OS username.
DATABASE_URL=postgres://adish@/uniliv_thapar?host=/var/run/postgresql

# Over TCP instead, if your Postgres role has a password set:
# DATABASE_URL=postgres://user:password@localhost:5432/uniliv_thapar
