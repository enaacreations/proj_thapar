PORT=4000
NODE_ENV=development
# Comma-separated origins, or * to allow any.
CORS_ORIGIN=*

# Local Postgres over the Unix socket, using peer auth (no password needed).
# Replace "adish" with your OS username.
DATABASE_URL=postgres://adish@/thapar?host=/var/run/postgresql

# Over TCP instead, if your Postgres role has a password set:
# DATABASE_URL=postgres://user:password@localhost:5432/thapar

# Signs the mess pass and the attendance liveness challenge. Both fall back to
# a dev value locally and are required outright in production.
# MESS_PASS_SECRET=
# LIVENESS_SECRET=

# How close a face has to be to the enrolled one to count as the same person.
# Lower is stricter. 0.55 is the default; raise towards 0.6 if residents are
# being rejected in poor lighting, lower it if lookalikes get through.
# FACE_MATCH_THRESHOLD=0.55

# Where attendance face photos are stored. Defaults to apps/api/uploads.
# UPLOADS_DIR=/var/lib/thapar/uploads
