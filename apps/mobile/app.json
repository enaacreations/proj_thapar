{
  "expo": {
    "name": "Thapar Hostel",
    "slug": "thapar-hostel",
    "owner": "astropsumit",
    "scheme": "projthapar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.projthapar.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.projthapar.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8602C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://thapar.enaacreations.com",
      "eas": {
        "projectId": "991d4bbe-05b3-47b2-842f-ee0c96b8af1f"
      },
      "router": {}
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FCF9F6",
          "dark": {
            "backgroundColor": "#181210"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Thapar Hostel uses the camera so you can photograph a maintenance issue, hand over laundry, capture your ID document, or mark attendance and mess entry.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Thapar Hostel needs access to your photos so you can attach an existing picture to a request or use it as your profile photo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Thapar Hostel checks your location only at the moment you mark attendance, to confirm you are on the hostel premises. It is never tracked in the background."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Thapar Hostel uses Face ID so you can unlock the app and mark attendance without typing your MPIN. Your biometric data stays on your device."
        }
      ]
    ]
  }
}
